// Baseline x86_64 platform data.
//
// Platform inheritance is declared by the workspace manifest.

layout {
    // TODO: Introduce compile-time KASLR and call "normal" KASLR load-time KASLR.

    // The default base load virtual address.
    //
    // This value is standard for upper-half `x86-64` kernels. It is the last
    // `2 GiB` of the virtual address space.
    (virtual-address)base (u64)0xffff_ffff_8000_0000

    // The base physical address.
    //
    // This is the physical address the kernel is loaded at by default.
    (physical-address)physical-base (u64)0x0100_0000

    // For this architecture, use a "small" code model paired with a
    // position-independent executable.
    code-model "small"
    relocation-model "pie"
}

// The linkage section.
linkage {
    section-name ".nekor.linkage"

    // The symbol table for the dynamic segment. (`.dynsym`)
    table {
        section-name ".nekor.linkage.table"

        // The string table for the dynamic segment. (`.dynstr`)
        string {
            section-name ".nekor.linkage.string"
        }

        section {
            section-name ".nekor.linkage.section"
        }
    }

    // Dynamic linker hash tables for symbol resolution, both SysV and GNU
    // versions.
    hash {
        section-name ".nekor.linkage.hash"

        gnu {
            section-name ".nekor.linkage.hash.gnu"
        }
    }

    symbol {
        start "__nekor_linkage_start"
        end "__nekor_linkage_end"
    }

    // The relocation section.
    //
    // In this case we observe two cases. Relocations can have either implicit
    // or explicit addends.
    //
    // The relocation type can be determined via section flags. We use the
    // section name defined here as our prefix and append either `.implicit` or
    // `.explicit` to define the relocation tables.
    relocate {
        section-name ".nekor.relocate"

        symbol {
            // NOTE: There is no need for symbols in this case.
        }
    }
}

// Debugging configuration.
debug {
    // Not a usermode target.
    usermode #false

    // Whether the build should be verbose.
    verbose #true

    // The explicit whitelist of permitted debuginfo program sections.
    info {
        - ".debug_abbrev"
        - ".debug_aranges"
        - ".debug_frame"
        - ".debug_info"
        - ".debug_line"
        - ".debug_loc"
        - ".debug_ranges"
        - ".debug_str"
    }

    // The kernel symbol table.
    symbol {
        section-name ".nekor.debug.symbol"

        // The strings for the kernel symbol table.
        string {
            section-name ".nekor.debug.symbol.string"
        }
    }
}

// The bootloader section.
//
// This contains the bootloader request and response block.
//
// This is reclaimed after boot.
boot {
    section-name ".nekor.boot"
    symbol "(Nekor Boot Record)"

    // Bootloader feature requirements.
    feature {
        section-name ".nekor.boot.feature"

        // The symbol pointing to the feature list string.
        symbol "(Nekor Boot Features)"

        // The feature list to request from the bootloader.
        //
        // This is placed in the `PT_INTERP` program segment.
        //
        // On `usermode` builds, this is not set and the regular userspace
        // dynamic program interpreter is used instead of a bootloader.
        list {
            - "nekor-boot-v0"
        }
    }

    request {
        section-name ".nekor.boot.request"
        symbol "(Nekor Boot Request)"
    }
}

// Mitigation options.
mitigate {
}

// Unwinding configuration.
unwind {
    // Always use frame pointers for unwinding.
    frame-pointer #true

    // Do not use nor include unwind tables in the final binary.
    unwind-table #false
}

// Kernel sections and symbols.
kernel {
    // Processor-local template section.
    //
    // This is located in the `PT_TLS` program segment and is used for
    // processor-local variables.
    local {
        section-name ".nekor.local"

        symbol {
            start "__nekor_local_start"
            end "__nekor_local_end"
        }
    }

    // Kernel code section.
    code {
        section-name ".nekor.code"

        symbol {
            start "__nekor_code_start"
            end "__nekor_code_end"
        }
    }

    // Kernel data section.
    data {
        section-name ".nekor.data"

        symbol {
            start "__nekor_data_start"
            end "__nekor_data_end"
        }

        zeroed {
            section-name ".nekor.data.zeroed"

            symbol {
                start "__nekor_data_zeroed_start"
                end "__nekor_data_zeroed_end"
            }
        }

        readonly {
            section-name ".nekor.data.readonly"

            symbol {
                start "__nekor_data_readonly_start"
                end "__nekor_data_readonly_end"
            }
        }
    }

    // Hot sections and D- and I-cache compaction.
    //
    // These are placed in the same area as the regular code or data sections,
    // but they are made first in the list.
    hot {
        // Hot code section.
        code {
            section-name ".nekor.hot.code"

            symbol {
                start "__nekor_hot_code_start"
                end "__nekor_hot_code_end"
            }
        }

        // Hot data section.
        data {
            section-name ".nekor.hot.data"

            // Start and end boundaries for hot data.
            symbol {
                start "__nekor_hot_data_start"
                end "__nekor_hot_data_end"
            }
        }
    }

    // The system-level asynchronous scheduler.
    schedule {
        // Contextual isolate storage used in the scheduler.
        isolate {
            section-name ".nekor.schedule.isolate"

            symbol {
                start "__nekor_schedule_isolate_start"
                end "__nekor_schedule_isolate_end"
            }
        }

        // Global run-queue list section.
        queue {
            section-name ".nekor.schedule.queue"

            symbol {
                start "__nekor_schedule_queue_start"
                end "__nekor_schedule_queue_end"
            }
        }

        // Interrupt code and data sections.
        interrupt {
            // Interrupt code section.
            code {
                section-name ".nekor.schedule.interrupt.code"

                symbol {
                    start "__nekor_schedule_interrupt_code_start"
                    end "__nekor_schedule_interrupt_code_end"
                }
            }

            // Interrupt data section.
            data {
                section-name ".nekor.schedule.interrupt.data"

                symbol {
                    start "__nekor_schedule_interrupt_data_start"
                    end "__nekor_schedule_interrupt_data_end"
                }
            }
        }
    }

    // Code section for the hotpatch system.
    patch {
        section-name ".nekor.patch"
        patchsite-symbol "__nekor_patch"

        symbol {
            start "__nekor_patch_start"
            end "__nekor_patch_end"
        }
    }

    // Data section for the Domain system.
    //
    // This is for internal kernel use and is treated as regular read-write
    // data.
    domain {
        section-name ".nekor.domain"
    }
}

// Architecture-level constants.
arch {
    page {
        size {
            (bytes)normal (u64)0x1000       // 4 KiB
            (bytes)huge (u64)0x20_0000     // 2 MiB
            (bytes)giga (u64)0x4000_0000   // 1 GiB
        }
    }

    cache {
        // The size of a cache line that is pulled from `Ln` cache.
        (bytes)size (u64)0x40
    }
}
