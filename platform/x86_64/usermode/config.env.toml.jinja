[env]
NEKOR_BACKOFF_X86_PAUSES_PER_CHAIN = "{{ arch.backoff["pauses-per-chain"] }}"
NEKOR_BACKOFF_X86_CHAINS_PER_CHECK = "{{ arch.backoff["chains-per-check"] }}"
NEKOR_BACKOFF_X86_MAX_DELAY_TICKS = "{{ arch.backoff["max-delay-ticks"] }}"

KERNEL_DOMAIN_STORAGE_SECTION = "{{ kernel.domain["section-name"] }}"
KERNEL_SCHEDULE_QUEUE_SECTION = "{{ kernel.schedule.queue["section-name"] }}"

KERNEL_PATCH_STORAGE_SECTION = "{{ kernel.patch["section-name"] }}"
KERNEL_PATCH_PATCHSITE_SYMBOL = "{{ kernel.patch["patchsite-symbol"] }}"

BOOTLOADER_ANCHOR_SECTION = "{{ boot["section-name"] }}"
BOOTLOADER_ANCHOR_SYMBOL = "{{ boot.symbol }}"

BOOTLOADER_FEATURE_LIST = "{{ boot.feature.list | join(",") }}"
BOOTLOADER_FEATURE_SECTION = "{{ boot.feature["section-name"] }}"
BOOTLOADER_FEATURE_SYMBOL = "{{ boot.feature.symbol }}"

BOOTLOADER_REQUEST_SECTION = "{{ boot.request["section-name"] }}"
BOOTLOADER_REQUEST_SYMBOL = "{{ boot.request.symbol }}"
