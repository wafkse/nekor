/*
  An ad-hoc linker script to support Nekor Kernel subsystems.
*/

/* WARNING: The linker can be a bit moronic and include pure data sections in non-corresponding program
   segments with completely wrong protection flags. This usually happens with a non-pinned `nightly` rustc. */

/* NOTE: This is the ad-hoc section command for all read-write data. */
SECTIONS {
  /*
    NOTE: Keep patch code and metadata together in writable RAM supplied by
    the host loader. The patch slots make this section executable.

    Page boundaries isolate its protection requirements from ordinary data.
  */
  {{ kernel.patch["section-name"] }}
  ALIGN({{ arch.page.size.normal }}) :
  AT(ADDR({{ kernel.patch["section-name"] }}) - {{ layout.base - layout["physical-base"] }}) {
    {{ kernel.patch.symbol.start }} = .;

    KEEP(*(SORT_BY_NAME({{ kernel.patch["section-name"] }} {{ kernel.patch["section-name"] }}.*)))

    . = ALIGN({{ arch.page.size.normal }});
    {{ kernel.patch.symbol.end }} = .;
  }

  /*
    NOTE: The domain-storage section.

    Since this section command is placed after the regular `.data` section, and is emitted with a
    `SHT_PROGBITS` section type and a set of `SHF_ALLOC + SHF_WRITE` section flags, it should reside
    in the same program segment as the regular `.data` section.
  */
  {{ kernel.domain["section-name"] }}
  ALIGN({{ arch.page.size.normal }}) :
  AT(ADDR({{ kernel.domain["section-name"] }}) - {{ layout.base - layout["physical-base"] }}) {
    /* NOTE: Each input section contains shared storage with per-type alignment. */
    KEEP(*(SORT_BY_ALIGNMENT({{ kernel.domain["section-name"] }})))
  }


} INSERT AFTER .data

