set shell := ["bash", "-euo", "pipefail", "-c"]

host_triple := `rustc --print host-tuple`
default_target_triple := env("CARGO_BUILD_TARGET", host_triple)

# Prepare the pinned sparse checkout and export headers for the selected target.
checkout kernel_channel target_triple=default_target_triple:
    bash script/checkout.bash {{ quote(kernel_channel) }} {{ quote(target_triple) }}

# Generate the default and processed binding files, replacing only changed output.
generate kernel_channel target_triple=default_target_triple: (checkout kernel_channel target_triple)
    #!/usr/bin/env bash
    set -euo pipefail

    KERNEL_CHANNEL={{ quote(kernel_channel) }}
    TARGET_TRIPLE={{ quote(target_triple) }}
    PACKAGE_ID=$(cargo pkgid --locked --offline -p nekor-virt-kvm-sys)
    CRATE_VERSION=${PACKAGE_ID##*[@#]}
    KERNEL_TAG=$(git config -f checkout/version.config --get "release.$CRATE_VERSION.$KERNEL_CHANNEL-tag")
    KERNEL_COMMIT=$(git config -f checkout/version.config --get "release.$CRATE_VERSION.$KERNEL_CHANNEL-commit")

    BUILD_MESSAGE_STREAM=$(
        NEKOR_KVM_CHANNEL="$KERNEL_CHANNEL" \
        NEKOR_KVM_TAG="$KERNEL_TAG" \
        NEKOR_KVM_COMMIT="$KERNEL_COMMIT" \
        NEKOR_KVM_TARGET="$TARGET_TRIPLE" \
        cargo build \
            --locked \
            --package nekor-virt-kvm-sys \
            --no-default-features \
            --features internal-generate-binding \
            --target {{ quote(host_triple) }} \
            --message-format json
    )

    BUILD_OUTPUT_DIRECTORY=$(
        jq --slurp --raw-output --exit-status --arg package_id "$PACKAGE_ID" '
            map(select(
                .reason == "build-script-executed" and .package_id == $package_id
            ))
            | if length == 1 then .[0].out_dir
              else error("expected one KVM build-script output")
              end
        ' <<< "$BUILD_MESSAGE_STREAM"
    )

    BINDING_DIRECTORY="src/generated/$KERNEL_CHANNEL/$TARGET_TRIPLE"

    mkdir -p "$BINDING_DIRECTORY"

    BINDING_STEM_LIST=(binding-default binding-processed)

    for BINDING_STEM in "${BINDING_STEM_LIST[@]}"; do
        GENERATED_SOURCE_PATH="$BUILD_OUTPUT_DIRECTORY/$TARGET_TRIPLE/$KERNEL_CHANNEL/$BINDING_STEM.rs"

        rustfmt --config-path ../../rustfmt.toml "$GENERATED_SOURCE_PATH"

        if ! cmp --silent "$GENERATED_SOURCE_PATH" "$BINDING_DIRECTORY/$BINDING_STEM.rs"; then
            cp "$GENERATED_SOURCE_PATH" "$BINDING_DIRECTORY/$BINDING_STEM.rs"
        fi
    done

# Regenerate both pinned interfaces.
generate-all target_triple=default_target_triple: (generate "lts" target_triple) (generate "stable" target_triple)

# Prepare the selected binding pair and compile that interface.
build kernel_channel target_triple=default_target_triple: (generate kernel_channel target_triple)
    cargo build --locked --package nekor-virt-kvm-sys \
        --no-default-features --features {{ quote(kernel_channel) }} --target {{ quote(target_triple) }}
